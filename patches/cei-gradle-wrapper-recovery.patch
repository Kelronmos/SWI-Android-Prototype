+schema: swi-cei-diagnostic/v1
+id: CEI-GRADLE-WRAPPER-001
+name: Gradle Wrapper and Android Build Recovery
+status: documented
+scope:
+  - Termux
+  - Linux
+  - macOS
+  - Windows
+signatures:
+  - id: EMPTY_PROJECT_DIRECTORY
+    match: "does not contain a Gradle build"
+    cause: wrapper_task_outside_project_root
+    severity: error
