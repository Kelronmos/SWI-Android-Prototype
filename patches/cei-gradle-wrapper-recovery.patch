+    cause: http_head_validation_failure_possible
+    severity: error
+    recovery: diagnose_head_then_optional_no_validate_url
+    caveat: "HEAD failure does not establish GET/download failure"
+  - id: DISTRIBUTION_DOWNLOAD_FAILURE
